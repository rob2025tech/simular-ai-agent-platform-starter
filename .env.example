# ---- routing -------------------------------------------------------------
# explicit | cheapest_first | credits_first | local_first
ROUTING_STRATEGY=local_first

# ---- explicit vendor choices (used when ROUTING_STRATEGY=explicit) --------
LLM_PROVIDER=ollama
EMBEDDINGS_PROVIDER=fastembed
VECTOR_PROVIDER=chroma
SEARCH_PROVIDER=duckduckgo
STORAGE_PROVIDER=sqlite
OBS_PROVIDER=console

# ---- free / local --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
CHROMA_PATH=./.data/chroma
SQLITE_PATH=./.data/app.db

# ---- keyed vendors (leave blank to have the router skip them) ------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
DATABASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
